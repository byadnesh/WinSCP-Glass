<UserControl x:Class="WinScpGlass.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:WinScpGlass.Controls"
             xmlns:vm="clr-namespace:WinScpGlass.ViewModels"
             xmlns:views="clr-namespace:WinScpGlass.Views"
             xmlns:term="clr-namespace:WinScpGlass.Terminal"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SessionViewModel}"
             PreviewKeyDown="Session_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TerminalRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ Command capsule -->
        <Grid Margin="0,0,0,14">
            <Border Style="{StaticResource ChipBorder}" CornerRadius="24" Padding="6" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="Upload" ctl:UiProps.Icon="&#xE898;"
                            Command="{Binding UploadCommand}" ToolTip="Copy the selected local items to the server" ctl:UiProps.CornerRadius="17" />
                    <Button Style="{StaticResource GhostButton}" Content="Download" ctl:UiProps.Icon="&#xE896;"
                            Command="{Binding DownloadCommand}" ToolTip="Copy the selected server items to this PC" ctl:UiProps.CornerRadius="17" />
                    <Border Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource GhostButton}" Content="New folder" ctl:UiProps.Icon="&#xE8F4;"
                            Command="{Binding NewFolderCommand}" ToolTip="Ctrl+Shift+N" ctl:UiProps.CornerRadius="17" />
                    <Button Style="{StaticResource GhostButton}" Content="Rename" ctl:UiProps.Icon="&#xE8AC;"
                            Command="{Binding RenameCommand}" ToolTip="F2" ctl:UiProps.CornerRadius="17" />
                    <Button Style="{StaticResource GhostButton}" Content="Delete" ctl:UiProps.Icon="&#xE74D;"
                            Command="{Binding DeleteCommand}" ToolTip="Del" ctl:UiProps.CornerRadius="17" />
                    <Border Style="{StaticResource VDivider}" />
                    <Button Style="{StaticResource GhostIconButton}" Width="34" Height="34" ctl:UiProps.CornerRadius="17" ctl:UiProps.Icon="&#xE72C;"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" />
                    <Border Style="{StaticResource VDivider}" Visibility="{Binding HasTerminal, Converter={StaticResource BoolToVisible}}" />
                    <ToggleButton Style="{StaticResource GhostToggle}" Content="Terminal" ctl:UiProps.Icon="&#xE756;" ctl:UiProps.CornerRadius="17"
                                  IsChecked="{Binding IsTerminalVisible}" ToolTip="Show or hide the terminal (Ctrl+`)"
                                  Visibility="{Binding HasTerminal, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource ChipBorder}" CornerRadius="24" Padding="16,6,8,6" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource GlassSwitch}" FontSize="13" Content="Hidden files"
                              IsChecked="{Binding ShowHiddenFiles}" ToolTip="Show hidden and system files on this PC" />
                </Border>
                <Button Style="{StaticResource GlassButton}" Content="Disconnect" ctl:UiProps.Icon="&#xE7E8;" Margin="10,0,0,0"
                        Height="46" ctl:UiProps.CornerRadius="23" Padding="18,0" Command="{Binding DisconnectCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:FilePanelView x:Name="LocalView" DataContext="{Binding Local}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Width="44" Height="44" Padding="0" ctl:UiProps.CornerRadius="22"
                        ctl:UiProps.Icon="&#xE72A;" FontSize="15" Command="{Binding UploadCommand}" ToolTip="Upload selection  →" />
                <Button Style="{StaticResource IconButton}" Width="44" Height="44" ctl:UiProps.CornerRadius="22" Margin="0,14,0,0"
                        ctl:UiProps.Icon="&#xE72B;" FontSize="15" Command="{Binding DownloadCommand}" ToolTip="←  Download selection" />
            </StackPanel>

            <views:FilePanelView x:Name="RemoteView" Grid.Column="2" DataContext="{Binding Remote}" />

            <!-- Reconnecting veil -->
            <Grid Grid.ColumnSpan="3" Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisible}}">
                <Border CornerRadius="24" Background="{DynamicResource GlassFillStrongBrush}" Opacity="0.85" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Control Style="{StaticResource Spinner}" Width="36" Height="36" />
                    <TextBlock Text="Reconnecting…" Style="{StaticResource HeadingText}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================ Terminal -->
        <GridSplitter x:Name="TerminalSplitter" Grid.Row="2" Height="14" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False"
                      Cursor="SizeNS" DragCompleted="TerminalSplitter_DragCompleted"
                      Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisible}}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="44" Height="4" CornerRadius="2" Background="{DynamicResource ThumbBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="64" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <ContentControl x:Name="TerminalCard" Grid.Row="3" Style="{StaticResource GlassCard}" Padding="16,12,12,12"
                        DataContext="{Binding Terminal}"
                        Visibility="{Binding DataContext.IsTerminalVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisible}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30">
                        <Ellipse Fill="{DynamicResource AccentGradientBrush}" />
                        <Ellipse Fill="{DynamicResource AccentGlossBrush}" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Terminal" Style="{StaticResource HeadingText}" FontSize="15" />
                        <Border Style="{StaticResource ChipBorder}" Padding="10,3" Margin="12,0,0,0" CornerRadius="11" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Connecting">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Current folder" ctl:UiProps.Icon="&#xE8B7;"
                                Command="{Binding DataContext.TerminalGoToFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="{Binding IsConnected}" ToolTip="cd into the folder open in the server panel" />
                        <Button Style="{StaticResource GhostButton}" Content="Reconnect" ctl:UiProps.Icon="&#xE72C;"
                                Command="{Binding ReconnectCommand}" Visibility="{Binding CanReconnect, Converter={StaticResource BoolToVisible}}" />
                        <Button Style="{StaticResource GhostIconButton}" ctl:UiProps.Icon="&#xE75C;" ToolTip="Clear" Command="{Binding ClearCommand}" />
                        <Button Style="{StaticResource GhostIconButton}" ctl:UiProps.Icon="&#xE70D;" ToolTip="Hide terminal (Ctrl+`)"
                                Command="{Binding DataContext.ToggleTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Grid>

                <!-- Cyberpunk screen: pure black, neon green phosphor, faint CRT scanlines -->
                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="16" Background="#000000"
                        BorderBrush="#5539FF7F" BorderThickness="1" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#39FF7F" Opacity="0.22" />
                    </Border.Effect>
                    <Grid>
                        <term:TerminalView x:Name="TerminalView" Margin="2">
                            <term:TerminalView.Effect>
                                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#39FF7F" Opacity="0.3" />
                            </term:TerminalView.Effect>
                        </term:TerminalView>
                        <Rectangle IsHitTestVisible="False" RadiusX="15" RadiusY="15">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#1F000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,2,4,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle IsHitTestVisible="False" RadiusX="15" RadiusY="15">
                            <Rectangle.Fill>
                                <RadialGradientBrush RadiusX="0.75" RadiusY="0.85">
                                    <GradientStop Color="#00000000" Offset="0.6" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>
            </Grid>
        </ContentControl>

        <!-- ============================================================ Transfers -->
        <ContentControl Grid.Row="4" Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="16,12,12,10"
                        DataContext="{Binding Queue}"
                        Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30">
                        <Ellipse Fill="{DynamicResource AccentGradientBrush}" />
                        <Ellipse Fill="{DynamicResource AccentGlossBrush}" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Transfers" Style="{StaticResource HeadingText}" FontSize="15" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="12,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Grid.Column="2" Style="{StaticResource GlassProgress}" Value="{Binding OverallProgress, Mode=OneWay}"
                                 Width="200" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel all" Command="{Binding CancelAllCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear finished" Command="{Binding ClearFinishedCommand}" />
                        <ToggleButton Style="{StaticResource GhostIconButton}" Margin="4,0,0,0" IsChecked="{Binding IsExpanded}"
                                      ctl:UiProps.Icon="&#xE70D;" ToolTip="Show or hide the list" />
                    </StackPanel>
                </Grid>

                <ListBox Style="{StaticResource GlassList}" ItemsSource="{Binding Jobs}" MaxHeight="196" Margin="0,8,0,0"
                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TransferJob}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32">
                                    <Border x:Name="IconBg" CornerRadius="11" Background="{DynamicResource FieldFillBrush}" />
                                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" Text="{Binding Glyph}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="{Binding RouteText}" Style="{StaticResource CaptionText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="Bar" Style="{StaticResource GlassProgress}" Height="4" Margin="0,6,0,0"
                                                 Value="{Binding Progress, Mode=OneWay}" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusText}" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusText}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button x:Name="RetryBtn" Style="{StaticResource GhostIconButton}" ctl:UiProps.Icon="&#xE72C;" ToolTip="Retry"
                                            Visibility="Collapsed"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button x:Name="CancelBtn" Style="{StaticResource GhostIconButton}" ctl:UiProps.Icon="&#xE711;" ToolTip="Cancel"
                                            Visibility="Collapsed"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="CancelBtn" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xE73E;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Setter TargetName="RetryBtn" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Canceled">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Setter TargetName="RetryBtn" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
