<Window x:Class="WinScpGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WinScpGlass.Controls"
        xmlns:vm="clr-namespace:WinScpGlass.ViewModels"
        xmlns:views="clr-namespace:WinScpGlass.Views"
        Title="WinSCP Glass"
        Width="1320" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <views:SessionView />
        </DataTemplate>

        <!-- Ambient orb: a soft radial light that fades to nothing -->
        <Style x:Key="Orb" TargetType="Ellipse">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 1. Glass tint over the OS acrylic backdrop -->
        <Border Background="{DynamicResource WindowTintBrush}" />

        <!-- 2. Drifting light: the "environment" the glass refracts -->
        <Grid x:Name="Ambient" IsHitTestVisible="False" ClipToBounds="True" Opacity="{DynamicResource OrbOpacity}">
            <Ellipse Style="{StaticResource Orb}" Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-260,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Orb1Color}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb1" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Style="{StaticResource Orb}" Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-200,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Orb2Color}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb2" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Style="{StaticResource Orb}" Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Orb3Color}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb3" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Style="{StaticResource Orb}" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource Orb4Color}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb4" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="X" From="0" To="220" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="Y" From="0" To="140" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb2" Storyboard.TargetProperty="X" From="0" To="-260" Duration="0:0:29" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb2" Storyboard.TargetProperty="Y" From="0" To="200" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb3" Storyboard.TargetProperty="X" From="0" To="-300" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb3" Storyboard.TargetProperty="Y" From="0" To="-160" Duration="0:0:35" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb4" Storyboard.TargetProperty="X" From="0" To="260" Duration="0:0:33" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Orb4" Storyboard.TargetProperty="Y" From="0" To="-120" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <!-- 3. The app -->
        <Grid x:Name="AppLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="26" Height="26">
                        <Ellipse Fill="{DynamicResource AccentGradientBrush}" />
                        <Ellipse Fill="{DynamicResource AccentGlossBrush}" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="WinSCP" Margin="10,0,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                    <TextBlock Text="Glass" Margin="5,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- Connected session capsule -->
                <Border Grid.Column="1" Style="{StaticResource ChipBorder}" VerticalAlignment="Center" Padding="14,6"
                        Visibility="{Binding Session, Converter={StaticResource ValueToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#4ADE9B" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Session.ChipText}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Text="{Binding Session.ProtocolLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" FontSize="13" Width="34" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ctl:UiProps.Icon="&#xE706;"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Switch light / dark" />
                    <Button Style="{StaticResource CaptionButton}" ctl:UiProps.Icon="&#xE921;" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ctl:UiProps.Icon="&#xE922;" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" Margin="4,0" />
                    <Button Style="{StaticResource CloseCaptionButton}" ctl:UiProps.Icon="&#xE8BB;" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <ctl:FluidContent Grid.Row="1" Content="{Binding CurrentView}" Focusable="False" Margin="16,2,16,16" />
        </Grid>

        <!-- 4. Dialog sheet floating over the blurred app -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}" />
            <ContentControl x:Name="Sheet" Style="{StaticResource GlassSheet}" Width="480"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" />
                </ContentControl.RenderTransform>
                <views:DialogSheet x:Name="SheetContent" />
            </ContentControl>
        </Grid>

        <!-- 5. Toasts -->
        <ItemsControl ItemsSource="{Binding Toasts}" IsHitTestVisible="False" Focusable="False"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:Toast}">
                    <Border x:Name="Pill" Margin="0,6,0,0" CornerRadius="20" Padding="16,10,20,10" HorizontalAlignment="Center"
                            Background="{DynamicResource MenuFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="S" />
                                <TranslateTransform x:Name="T" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.3" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="Success">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Danger">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Warning">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" From="24" To="0" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
