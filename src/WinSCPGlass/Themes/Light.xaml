<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Liquid glass, light environment -->

    <LinearGradientBrush x:Key="WindowTintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C7EEF1FA" Offset="0" />
        <GradientStop Color="#C7F4EEFA" Offset="0.55" />
        <GradientStop Color="#C7E9F4F8" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="Orb1Color">#9D8BFF</Color>
    <Color x:Key="Orb2Color">#5FD3FF</Color>
    <Color x:Key="Orb3Color">#FF8DC0</Color>
    <Color x:Key="Orb4Color">#6EF0C4</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="OrbOpacity">0.6</sys:Double>

    <SolidColorBrush x:Key="GlassFillBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="GlassFillStrongBrush" Color="#EBFAFBFF" />
    <SolidColorBrush x:Key="GlassFillSubtleBrush" Color="#40FFFFFF" />
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#99FFFFFF" Offset="0.45" />
        <GradientStop Color="#59FFFFFF" Offset="0.7" />
        <GradientStop Color="#E6FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.35" />
    </LinearGradientBrush>
    <Color x:Key="GlassShadowColor">#28306A</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="GlassShadowOpacity">0.16</sys:Double>

    <SolidColorBrush x:Key="HoverFillBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="PressedFillBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="SelectedFillBrush" Color="#405468FF" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#805468FF" />
    <SolidColorBrush x:Key="FieldFillBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#1A1B2350" />
    <SolidColorBrush x:Key="DividerBrush" Color="#141B2350" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#38202850" />
    <SolidColorBrush x:Key="MenuFillBrush" Color="#F7FBFCFF" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#401B2350" />
    <SolidColorBrush x:Key="SegmentOnBrush" Color="#F2FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#121528" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3293050" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80394066" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <Color x:Key="AccentColor">#5468FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#4A5CF0" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F72FF" Offset="0" />
        <GradientStop Color="#8E5BF7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DangerBrush" Color="#E5355A" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#26E5355A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#11A86A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
</ResourceDictionary>
